+def validate_resume_configuration(saved, expectedconfig):
+    """Only registered8c/v3/noGC may lack these newly introduced metadata fields."""
+    optional = {"literal_protocol", "literal_helper_sha256", "literal_word_ranges_sha256",
+        "gradient_checkpointing", "gradient_checkpointing_use_reentrant",
+        "gradient_checkpointing_model_source_sha256", "gradient_checkpointing_framework_source_sha256",
+        "gradient_checkpointing_enable_source_sha256", "gradient_checkpointing_checkpoint_source_sha256"}
+    legacy_v3_no_gc = (type(saved.get("schema_version")) is int and saved.get("schema_version") == 1
+        and expectedconfig.get("literal_helper_sha256") == "9ee736685aab7decc213937ced67f7e37df65d4f5cad0240dd6e266002073561"
+        and saved.get("training_source_sha256") == "8c609cd04f058adb565dd489029e6daa3b1728d5ea57420541e5a8b990f59fad"
+        and saved.get("literal_protocol", PROTOCOL) == "specialist-compact-v3"
+        and expectedconfig.get("literal_protocol", PROTOCOL) == "specialist-compact-v3"
+        and saved.get("gradient_checkpointing", False) is False
+        and expectedconfig.get("gradient_checkpointing", False) is False)
+    if expectedconfig.get("gradient_checkpointing") is True and saved.get("packages") != expectedconfig.get("packages"):
+        raise ValueError("Checkpoint configuration mismatch: checkpointing packages")
+    missing = []
+    for key in RESUME_CONFIG_KEYS:
+        if key in optional and key in expectedconfig and key not in saved:
+            if legacy_v3_no_gc:
+                missing.append(key)
+                continue
+            raise ValueError("Checkpoint configuration missing required mode field: " + key)
+        if key in expectedconfig or key in saved:
+            if (expectedconfig.get(key) != saved.get(key)
+                    or key in optional and key in expectedconfig and key in saved
+                    and type(expectedconfig[key]) is not type(saved[key])):
+                raise ValueError("Checkpoint configuration mismatch: " + key)
+    return missing
