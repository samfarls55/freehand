--- /dev/null
+++ b/src/arch/qwen3_asr/tensor_catalog.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include "ggml.h"
+#include "gguf.h"
+#include "transcribe.h"
+
+#include <cstdint>
+#include <limits>
+
+namespace transcribe::qwen3_asr {
+
+// Metadata was validated by Loader::open. Recreate the same empty tensor
+// catalog that gguf_init_from_file(no_alloc=true, ctx!=nullptr) constructs,
+// without reopening and reparsing the metadata. The caller owns a successful
+// context; partial allocation stays local on failure.
+inline transcribe_status create_tensor_catalog(const gguf_context * metadata, ggml_context ** output) {
+    *output = nullptr;
+    const auto count = static_cast<size_t>(gguf_get_n_tensors(metadata));
+    const size_t overhead = ggml_tensor_overhead();
+    if (count != 0 && count > std::numeric_limits<size_t>::max() / overhead) {
+        return TRANSCRIBE_ERR_OOM;
+    }
+    ggml_init_params params{};
+    params.mem_size = count * overhead;
+    params.no_alloc = true;
+    ggml_context * catalog = ggml_init(params);
+    if (catalog == nullptr) {
+        return TRANSCRIBE_ERR_OOM;
+    }
+    for (size_t index = 0; index < count; ++index) {
+        ggml_tensor * tensor = ggml_new_tensor(catalog, gguf_get_tensor_type(metadata, index),
+                                              GGML_MAX_DIMS, gguf_get_tensor_ne(metadata, index));
+        if (tensor == nullptr) {
+            ggml_free(catalog);
+            return TRANSCRIBE_ERR_OOM;
+        }
+        ggml_set_name(tensor, gguf_get_tensor_name(metadata, index));
+    }
+    *output = catalog;
+    return TRANSCRIBE_OK;
+}
+
+} // namespace transcribe::qwen3_asr
