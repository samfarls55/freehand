+            baseline = text;
+        }
+        if ((i == 3 || hints[i] == nullptr) && text != baseline) {
+            ++failures;
+        }
+        if ((i == 1 || i == 2) && text.find("manta") == std::string::npos && text.find("Manta") == std::string::npos &&
+            text.find("MANTA") == std::string::npos) {
+            ++failures;
+        }
+        std::cout << "{\"case\":" << std::quoted(labels[i]) << ",\"text\":" << std::quoted(text) << "}\n";
+    }
+    transcribe_session_free(session);
+    transcribe_model_free(model);
+    std::fprintf(stderr, "dictionary ASR control failures: %d\n", failures);
+    return failures == 0 ? 0 : 1;
+}
