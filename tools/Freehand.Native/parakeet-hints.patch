diff --git a/tests/parakeet_hint_controls.cpp b/tests/parakeet_hint_controls.cpp
new file mode 100644
--- /dev/null
+++ b/tests/parakeet_hint_controls.cpp
@@ -0,0 +1,198 @@
+#include "arch/parakeet/context-bias.h"
+#include "gguf.h"
+#include "transcribe-log.h"
+#include "transcribe-model.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+// Standalone tokenizer controls deliberately do not initialize any backend or
+// load model weights. This replaces logging only in this test executable.
+namespace transcribe {
+void log_msg(transcribe_log_level, const char *, ...) {}
+}  // namespace transcribe
+
+// The shared metadata TU also contains model mutators. A tokenizer-only
+// executable has no model; abort if a test unexpectedly enters those paths.
+void transcribe_model::set_languages(std::vector<std::string>) {
+    std::abort();
+}
+
+void transcribe_model::set_translate_target_languages(std::vector<std::string>) {
+    std::abort();
+}
+
+void transcribe_model::set_translation_pairs(std::vector<std::string>) {
+    std::abort();
+}
+
+using transcribe::parakeet::ContextBias;
+int failures = 0;
+#define CHECK(value)                                                      \
+    do {                                                                  \
+        if (!(value)) {                                                   \
+            std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #value); \
+            ++failures;                                                   \
+        }                                                                 \
+    } while (0)
+
+float oracle_bonus(const std::vector<std::vector<int32_t>> & phrases, const std::vector<int> & history, int token) {
+    int              longest  = 0;
+    bool             terminal = false;
+    std::vector<int> trial    = history;
+    trial.push_back(token);
+    for (const auto & phrase : phrases) {
+        for (size_t length = 1; length <= phrase.size() && length <= trial.size(); ++length) {
+            bool match = true;
+            for (size_t i = 0; i < length; ++i) {
+                if (trial[trial.size() - length + i] != phrase[i]) {
+                    match = false;
+                    break;
+                }
+            }
+            if (match && static_cast<int>(length) >= longest) {
+                if (static_cast<int>(length) > longest) {
+                    terminal = false;
+                }
+                longest  = static_cast<int>(length);
+                terminal = terminal || length == phrase.size();
+            }
+        }
+    }
+    return longest == 0 ? 0.0f : longest > 1 || terminal ? 1.5f : 0.375f;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        return 2;
+    }
+    ContextBias                             graph;
+    const std::vector<std::vector<int32_t>> phrases{
+        { 1, 2, 3 },
+        { 2, 3 },
+        { 1, 2, 4 },
+        { 4 },
+        { 1, 2, 3 }
+    };
+    for (const auto & phrase : phrases) {
+        graph.add(phrase);
+    }
+    graph.finish();
+    std::vector<int> history;
+    unsigned         random = 19;
+    for (int step = 0; step < 5000; ++step) {
+        if (step % 103 == 0) {
+            graph.reset();
+            history.clear();
+        }
+        float logits[7];
+        float original[7];
+        for (int token = 0; token < 7; ++token) {
+            random          = random * 1664525u + 1013904223u;
+            logits[token]   = static_cast<float>(random % 100) / 10.0f;
+            original[token] = logits[token];
+            CHECK(graph.bonus(token) == oracle_bonus(phrases, history, token));
+        }
+        int expected = 0;
+        for (int token = 1; token < 7; ++token) {
+            const float candidate = logits[token] + (token == 6 ? 0.0f : oracle_bonus(phrases, history, token));
+            const float best = logits[expected] + (expected == 6 ? 0.0f : oracle_bonus(phrases, history, expected));
+            if (candidate > best) {
+                expected = token;
+            }
+        }
+        CHECK(graph.select(logits, 7, 6) == expected);
+        CHECK(std::memcmp(logits, original, sizeof(logits)) == 0);
+        // Blank never advances the context, matching the decoder hook.
+        if (expected != 6) {
+            graph.emitted(expected);
+            history.push_back(expected);
+        }
+    }
+    ContextBias positive;
+    positive.add({ 1, 2, 3 });
+    positive.finish();
+    float row[7]{ -10, 1, 0, 0, 1.2f, 0, -10 };
+    CHECK(positive.select(row, 7, 6) == 1);
+    positive.emitted(1);
+    float continuation[7]{ -10, 0, 1, 0, 2, 0, -10 };
+    CHECK(positive.select(continuation, 7, 6) == 2);
+    positive.emitted(2);
+    float completion[7]{ -10, 0, 0, 1, 2, 0, -10 };
+    CHECK(positive.select(completion, 7, 6) == 3);
+    positive.reset();
+    CHECK(positive.select(continuation, 7, 6) == 4);
+    float unrelated[7]{ -10, 0, 0, 0, 0, 20, 0 };
+    CHECK(positive.select(unrelated, 7, 6) == 5);
+
+    ggml_context *   tensors = nullptr;
+    gguf_init_params gp{ true, &tensors };
+    gguf_context *   file = gguf_init_from_file(argv[1], gp);
+    CHECK(file != nullptr);
+    if (file == nullptr) {
+        return 1;
+    }
+    transcribe::Tokenizer tok;
+    CHECK(tok.load(file) == TRANSCRIBE_OK);
+    CHECK(tok.blank_id() == 1024);
+    std::ifstream oracle(argv[2]);
+    std::string   line;
+    int           cases = 0;
+    while (std::getline(oracle, line)) {
+        const size_t tab = line.find('\t');
+        CHECK(tab != std::string::npos);
+        if (tab == std::string::npos) {
+            continue;
+        }
+        const std::string    phrase = line.substr(0, tab);
+        std::vector<int32_t> expected;
+        std::istringstream   ids(line.substr(tab + 1));
+        int                  id;
+        while (ids >> id) {
+            expected.push_back(id);
+        }
+        std::vector<int32_t> actual;
+        CHECK(tok.encode_sentencepiece_bpe(phrase, actual, 0, 1024, true) == TRANSCRIBE_OK);
+        CHECK(actual == expected);
+        ++cases;
+    }
+    CHECK(cases >= 10);
+    const char * words[]{ "Claude Code" };
+    ContextBias  request = transcribe::parakeet::compile_context_bias(tok, words, 1, 1024);
+    CHECK(!request.empty());
+    std::vector<int32_t> multiword;
+    CHECK(tok.encode_sentencepiece_bpe("Claude Code", multiword, 0, 1024, true) == TRANSCRIBE_OK);
+    CHECK(multiword.size() > 1);
+    for (int token : multiword) {
+        std::vector<float> blank_row(1025, -20.0f);
+        blank_row[1024] = 20.0f;
+        CHECK(request.select(blank_row.data(), 1025, 1024) == 1024);
+        std::vector<float> near_tie(1025, -20.0f);
+        near_tie[1024]  = 0.2f;
+        near_tie[token] = 0.0f;
+        CHECK(request.select(near_tie.data(), 1025, 1024) == token);
+        request.emitted(token);
+    }
+    // A fresh request never carries a completed/partial prefix from another.
+    ContextBias new_request = transcribe::parakeet::compile_context_bias(tok, words, 1, 1024);
+    for (int token = 0; token < 1024; ++token) {
+        ContextBias reset = request;
+        reset.reset();
+        CHECK(new_request.bonus(token) == reset.bonus(token));
+    }
+    const size_t nodes = request.nodes();
+    const char * duplicates[]{ "Claude Code", "Claude Code", "Claude Code" };
+    CHECK(transcribe::parakeet::compile_context_bias(tok, duplicates, 3, 1024).nodes() == nodes);
+    const char * unknown[]{ "\xf0\x9f\x98\x80" };
+    CHECK(transcribe::parakeet::compile_context_bias(tok, unknown, 1, 1024).empty());
+    CHECK(transcribe::parakeet::compile_context_bias(tok, nullptr, 0, 1024).empty());
+    gguf_free(file);
+    if (tensors != nullptr) {
+        ggml_free(tensors);
+    }
+    std::printf("hint controls: %d failures; 5000 independent graph rows; %d independent tokenizer cases\n", failures,
+                cases);
+    return failures == 0 ? 0 : 1;
+}
