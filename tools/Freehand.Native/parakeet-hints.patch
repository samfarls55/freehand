+        const transcribe_status status = transcribe_run(session, audio.data(), static_cast<int>(audio.size()), &rp);
+        if (status != TRANSCRIBE_OK) {
+            ++failures;
+            continue;
+        }
+        const std::string text = transcribe_full_text(session);
