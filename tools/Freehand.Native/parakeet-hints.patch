diff --git a/tests/upload_roundtrip.cpp b/tests/upload_roundtrip.cpp
new file mode 100644
--- /dev/null
+++ b/tests/upload_roundtrip.cpp
@@ -0,0 +1,69 @@
+#include "arch/qwen3_asr/qwen3_asr.h"
+#include "ggml-backend.h"
+#include "gguf.h"
+#include "transcribe.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+int main(int argc, char ** argv) {
+    if ((argc != 2 && argc != 3) || transcribe_init_backends_default() != TRANSCRIBE_OK) {
+        return 2;
+    }
+    transcribe_model_load_params params;
+    transcribe_model_load_params_init(&params);
+    params.backend          = argc == 3 ? TRANSCRIBE_BACKEND_AUTO : TRANSCRIBE_BACKEND_VULKAN;
+    transcribe_model * base = nullptr;
+    if (transcribe_model_load_file(argv[1], &params, &base) != TRANSCRIBE_OK) {
+        return 1;
+    }
+    auto * model = static_cast<transcribe::qwen3_asr::QwenAsrModel *>(base);
+    if (ggml_backend_dev_type(ggml_backend_get_device(model->plan.primary)) != GGML_BACKEND_DEVICE_TYPE_GPU) {
+        std::fprintf(stderr, "The upload control requires a discrete GPU.\n");
+        return 1;
+    }
+    gguf_init_params metadata_params{};
+    metadata_params.no_alloc = true;
+    gguf_context * metadata  = gguf_init_from_file(argv[1], metadata_params);
+    if (metadata == nullptr) {
+        return 1;
+    }
+    std::ifstream        file(argv[1], std::ios::binary);
+    constexpr size_t     chunk_size = size_t(16) << 20;
+    std::vector<uint8_t> expected(chunk_size), actual(chunk_size);
+    size_t               checked_bytes   = 0;
+    size_t               checked_tensors = 0;
+    for (ggml_tensor * tensor = ggml_get_first_tensor(model->ctx_meta); tensor != nullptr;
+         tensor               = ggml_get_next_tensor(model->ctx_meta, tensor)) {
+        const int64_t index = gguf_find_tensor(metadata, tensor->name);
+        if (index < 0 || gguf_get_tensor_size(metadata, index) != ggml_nbytes(tensor)) {
+            return 1;
+        }
+        const std::streamoff offset = static_cast<std::streamoff>(gguf_get_data_offset(metadata)) +
+                                      static_cast<std::streamoff>(gguf_get_tensor_offset(metadata, index));
+        file.seekg(offset);
+        for (size_t done = 0; done < ggml_nbytes(tensor);) {
+            const size_t size = std::min(chunk_size, ggml_nbytes(tensor) - done);
+            file.read(reinterpret_cast<char *>(expected.data()), static_cast<std::streamsize>(size));
+            if (!file) {
+                return 1;
+            }
+            ggml_backend_tensor_get(tensor, actual.data(), done, size);
+            if (std::memcmp(expected.data(), actual.data(), size) != 0) {
+                std::fprintf(stderr, "Upload mismatch in %s at offset %zu\n", tensor->name, done);
+                return 1;
+            }
+            checked_bytes += size;
+            done += size;
+        }
+        ++checked_tensors;
+    }
+    std::printf("{\"tensorsChecked\":%zu,\"bytesChecked\":%zu,\"mismatches\":0}\n", checked_tensors, checked_bytes);
+    gguf_free(metadata);
+    transcribe_model_free(base);
+    return 0;
+}
