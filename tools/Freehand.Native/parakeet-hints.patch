diff --git a/src/arch/parakeet/context-bias.h b/src/arch/parakeet/context-bias.h
new file mode 100644
--- /dev/null
+++ b/src/arch/parakeet/context-bias.h
@@ -0,0 +1,181 @@
+#pragma once
+
+#include "transcribe-tokenizer.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace transcribe::parakeet {
+
+// Per-request phrase prefixes. Scores are bounded per token, never summed
+// across duplicate phrases. The 1.5 ceiling matches Freehand's existing hint
+// score; unfinished root prefixes get only one quarter of that score.
+class ContextBias {
+    struct Edge {
+        int token;
+        int next;
+    };
+
+    struct Node {
+        std::vector<Edge> edges;
+        int               fail     = 0;
+        int               depth    = 0;
+        bool              terminal = false;
+    };
+
+    std::vector<Node> nodes_{ 1 };
+    int               state_ = 0;
+
+    int edge(int state, int token) const {
+        for (const Edge & e : nodes_[state].edges) {
+            if (e.token == token) {
+                return e.next;
+            }
+        }
+        return -1;
+    }
+
+    int next(int state, int token) const {
+        for (;;) {
+            const int found = edge(state, token);
+            if (found >= 0) {
+                return found;
+            }
+            if (state == 0) {
+                return 0;
+            }
+            state = nodes_[state].fail;
+        }
+    }
+
+  public:
+    bool empty() const { return nodes_.size() == 1; }
+
+    size_t nodes() const { return nodes_.size(); }
+
+    void reset() { state_ = 0; }
+
+    void add(const std::vector<int32_t> & tokens) {
+        int state = 0;
+        for (int token : tokens) {
+            int child = edge(state, token);
+            if (child < 0) {
+                child           = static_cast<int>(nodes_.size());
+                const int depth = nodes_[state].depth + 1;
+                nodes_[state].edges.push_back({ token, child });
+                nodes_.push_back(Node{});
+                nodes_.back().depth = depth;
+            }
+            state = child;
+        }
+        if (!tokens.empty()) {
+            nodes_[state].terminal = true;
+        }
+    }
+
+    void finish() {
+        std::vector<int> queue;
+        for (const Edge & e : nodes_[0].edges) {
+            queue.push_back(e.next);
+        }
+        for (size_t at = 0; at < queue.size(); ++at) {
+            const int parent = queue[at];
+            for (const Edge & e : nodes_[parent].edges) {
+                nodes_[e.next].fail = next(nodes_[parent].fail, e.token);
+                queue.push_back(e.next);
+            }
+        }
+        reset();
+    }
+
+    float bonus(int token) const {
+        const int child = next(state_, token);
+        if (child == 0) {
+            return 0.0f;
+        }
+        return nodes_[child].depth > 1 || nodes_[child].terminal ? 1.5f : 0.375f;
+    }
+
+    // Keep the input logits intact for confidence reporting and debug dumps.
+    // Only actual prefix continuations can challenge the unmodified argmax.
+    int select(const float * logits, int count, int blank) const {
+        int best = 0;
+        for (int i = 1; i < count; ++i) {
+            if (logits[i] > logits[best]) {
+                best = i;
+            }
+        }
+        float best_score = logits[best] + (best == blank ? 0.0f : bonus(best));
+        int   state      = state_;
+        for (;;) {
+            for (const Edge & e : nodes_[state].edges) {
+                const float candidate = logits[e.token] + bonus(e.token);
+                if (candidate > best_score || (candidate == best_score && e.token < best)) {
+                    best       = e.token;
+                    best_score = candidate;
+                }
+            }
+            if (state == 0) {
+                break;
+            }
+            state = nodes_[state].fail;
+        }
+        return best;
+    }
+
+    void emitted(int token) { state_ = next(state_, token); }
+};
+
+// The caller owns NFC normalization. Current Freehand hint inputs use the
+// existing supported character set. ASCII lowercase variants preserve the
+// shipped 110M adapter's case coverage for that set.
+inline ContextBias compile_context_bias(const Tokenizer & tok, const char * const * vocabulary, int count, int blank) {
+    ContextBias bias;
+    if (vocabulary == nullptr) {
+        return bias;
+    }
+    for (int i = 0; i < std::min(count, 40); ++i) {
+        if (vocabulary[i] == nullptr) {
+            continue;
+        }
+        const size_t length = std::strlen(vocabulary[i]);
+        if (length == 0 || length > 1024) {
+            continue;
+        }
+        const std::string original(vocabulary[i], length);
+        std::string       lowercase = original;
+        for (char & c : lowercase) {
+            if (c >= 'A' && c <= 'Z') {
+                c = static_cast<char>(c - 'A' + 'a');
+            }
+        }
+        for (int variant = 0; variant < 2; ++variant) {
+            if (variant == 1 && lowercase == original) {
+                break;
+            }
+            std::vector<int32_t> ids;
+            const std::string &  text = variant == 0 ? original : lowercase;
+            if (tok.encode_sentencepiece_bpe(text, ids, 0, blank, true) != TRANSCRIBE_OK || ids.empty() ||
+                ids.size() > 257) {
+                continue;
+            }
+            bool valid = true;
+            for (int id : ids) {
+                if (id < 0 || id >= blank || id == tok.unk_id() || tok.is_control(id)) {
+                    valid = false;
+                    break;
+                }
+            }
+            if (valid) {
+                bias.add(ids);
+            }
+        }
+    }
+    bias.finish();
+    return bias;
+}
+
+}  // namespace transcribe::parakeet
