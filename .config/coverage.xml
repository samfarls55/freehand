<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <Functions>
      <Exclude>
        <!-- Instrument application callers, not generated regex state machines.
             Profiler overhead can consume their production 100 ms timeout. -->
        <Function>^System\.Text\.RegularExpressions\.Generated\..*</Function>
      </Exclude>
    </Functions>
  </CodeCoverage>
</Configuration>
