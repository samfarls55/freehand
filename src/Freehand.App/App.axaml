<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Freehand.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="/Assets/tray.ico" />
    </Style>
  </Application.Styles>

  <!-- Secondary interface. The main window is the app; this is for status and reaching
       Freehand while working in something else. Avalonia's TrayIcon maps to the Windows
       notification area and needs no extra package. -->
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/tray.ico" ToolTipText="Freehand — hold the push-to-talk key to dictate">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show Freehand" Click="OnTrayShow" />
            <NativeMenuItem Header="Settings…" Click="OnTraySettings" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
