<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The ONLY project in the repo allowed to call Win32. Keep it thin: anything with
         logic in it is code CI cannot exercise. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Freehand.Platform.Windows</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Freehand.Abstractions\Freehand.Abstractions.csproj" />
  </ItemGroup>
</Project>
